#!/usr/bin/env bash
set -euo pipefail

ROOT="${DOTFILES_ROOT:-$HOME/dots}"
BIN="${DOTS_BIN:-$ROOT/dots-cli/target/release/dots}"

if [[ ! -x "$BIN" ]]; then
  printf 'dots binary not found at %s\n' "$BIN" >&2
  printf 'Build it with: cargo build --release --manifest-path %s/dots-cli/Cargo.toml\n' "$ROOT" >&2
  exit 1
fi

exec "$BIN" --home "$@"
