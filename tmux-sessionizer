#!/usr/bin/env bash

DIRS=(
    "$HOME"
    "$HOME/dev/"
    "$HOME/dev/uni"
    "$HOME/Documents/"
    "$HOME/Documents/dev"
    "$HOME/Documents/uni"
)

BLACKLIST=(
    .Trash
    Public
    Movies
    Music
    Library
    Desktop
    Documents/Zoom
)

blacklist_pattern=$(printf "|%s" "${BLACKLIST[@]}")
blacklist_pattern="/(${blacklist_pattern:1})(/|$)"

if [[ $# -eq 1 ]]; then
    selected="$1"
else
    selected=$({
        command -v zoxide &>/dev/null && zoxide query -l 2>/dev/null
        for dir in "${DIRS[@]}"; do
            [[ -d "$dir" ]] || continue
            fd . "$dir" --type d --max-depth 1
        done
    } | sed 's:/*$::' | grep -Ev "$blacklist_pattern" | awk '!seen[$0]++' | while IFS= read -r dir; do
        short="${dir#"$HOME/"}"
        session_name=$(basename "$dir" | tr ._ -)
        if tmux has-session -t "=$session_name" 2>/dev/null; then
            printf '\033[38;2;180;190;254m%s\t%s\033[0m\n' "$dir" "$short"
        else
            printf '%s\t%s\n' "$dir" "$short"
        fi
    done | fzf --with-nth=2 \
        --delimiter=$'\t' \
        --height=100% \
        --layout=reverse \
        --border=rounded \
        --ansi \
        --preview='eza --icons -la --git --group-directories-first --total-size --color=always {1}' \
        --preview-window=right:70%:wrap \
        --bind "ctrl-x:execute-silent(tmux kill-session -t \$(basename {1} | tr ._ -))+reload($0 --list)" \
        | cut -f1)
fi

# Generate list for reload (used by ctrl-x)
if [[ "$1" == "--list" ]]; then
    {
        command -v zoxide &>/dev/null && zoxide query -l 2>/dev/null
        for dir in "${DIRS[@]}"; do
            [[ -d "$dir" ]] || continue
            fd . "$dir" --type d --max-depth 1
        done
    } | sed 's:/*$::' | grep -Ev "$blacklist_pattern" | awk '!seen[$0]++' | while IFS= read -r dir; do
        short="${dir#"$HOME/"}"
        session_name=$(basename "$dir" | tr ._ -)
        if tmux has-session -t "=$session_name" 2>/dev/null; then
            printf '\033[38;2;180;190;254m%s\t%s\033[0m\n' "$dir" "$short"
        else
            printf '%s\t%s\n' "$dir" "$short"
        fi
    done
    exit 0
fi

[[ -n "$selected" ]] || exit 0

session_name=$(basename "$selected" | tr ._ -)

if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux new-session -ds "$session_name" -c "$selected"
fi

tmux switch-client -t "$session_name"
